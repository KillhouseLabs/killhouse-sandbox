# Server
SANDBOX_HOST=0.0.0.0
SANDBOX_PORT=8081
SANDBOX_DEBUG=false

# Docker
SANDBOX_DOCKER_HOST=unix:///var/run/docker.sock

# Environment settings
SANDBOX_ENVIRONMENT_TTL_MINUTES=30
SANDBOX_MAX_CONCURRENT_ENVIRONMENTS=5

# Resource limits
SANDBOX_CONTAINER_MEMORY_LIMIT=1g
SANDBOX_CONTAINER_CPU_LIMIT=1.0
SANDBOX_CONTAINER_PIDS_LIMIT=100

# Paths
SANDBOX_WORK_DIR=/tmp/killhouse-sandbox
SANDBOX_REPO_CLONE_PATH=/tmp/killhouse-sandbox/repos

# Timeouts
SANDBOX_BUILD_TIMEOUT_SECONDS=300
SANDBOX_STARTUP_TIMEOUT_SECONDS=60

# Logging
LOG_LEVEL=INFO
